# Copy to .env and fill in. .env is git-ignored and must never be committed
# (docs/threat-model.md T3, data class C8).
#
# Generate secrets with:  openssl rand -base64 32

# --- Environment ---
HC_ENVIRONMENT=dev          # dev | staging | prod
HC_DEBUG=false              # must stay false in prod; the app refuses to start otherwise

# --- Tailscale-only production edge (ADR-0007) ---
# Leave these defaults unset for local development. Production requires the host's
# concrete 100.64.0.0/10 address, its full MagicDNS name, and a mode-0700 directory
# containing healthcurve.crt and healthcurve.key (key mode 0600).
# HC_CADDY_BIND_IP=100.x.y.z
# HC_CADDY_HOST_PORT=443
# HC_CADDY_CONTAINER_PORT=443
# HC_TAILSCALE_DNS_NAME=machine.example-tailnet.ts.net
# HC_TAILSCALE_CERT_DIR=/absolute/path/to/private/certificate-directory

# --- Database (ADR-0001) ---
POSTGRES_PASSWORD=          # required by docker-compose
POSTGRES_AI_PASSWORD=       # required; the restricted role that cannot write facts or plans
POSTGRES_BACKUP_PASSWORD=   # required only for backups; dedicated read-only dump role
HC_DATABASE_URL=postgresql+psycopg://healthcurve@localhost:5432/healthcurve
# The restricted role, used only where model output becomes a draft (SAFE-15/16).
# docker-compose sets both automatically; this matters for a non-Docker run.
# Required in production: the app refuses to start without it, and refuses to start
# if it is the same URL as HC_DATABASE_URL.
HC_AI_DATABASE_URL=postgresql+psycopg://healthcurve_ai@localhost:5432/healthcurve

# --- Local LLM (ADR-0017) ---
# The normal Mac runtime uses host-native Ollama so Metal remains available and model
# blobs are not duplicated in Docker. A public URL is a startup failure, not a warning.
HC_OLLAMA_BASE_URL=http://host.docker.internal:11434
HC_OLLAMA_MODEL=qwen3:30b
HC_OLLAMA_VISION_MODEL=qwen3-vl:30b
HC_OLLAMA_CONNECT_TIMEOUT_S=5
HC_OLLAMA_READ_TIMEOUT_S=60
HC_OLLAMA_MAX_RETRIES=2
# Extraction is deterministic parsing, so reasoning is disabled unless explicitly
# comparing model behavior. It must never be used to invent or approve a plan.
HC_OLLAMA_THINKING=false

# Backup runner (deploy/backup.compose.yml). The recipient is an age PUBLIC key;
# never place the private identity on this host or in this file. In production the
# local directory must be a separate local/external backup medium, not the live disk.
HC_BACKUP_AGE_RECIPIENT=
HC_BACKUP_LOCAL_DIR=
HC_UPLOADS_DIR=./var/uploads
HC_REPORT_ARTIFACTS_DIR=./var/reports
HC_BACKUP_RETENTION_APPLY=true
# Poll interval for the network-isolated hostile-PDF validation worker.
HC_DOCUMENT_POLL_INTERVAL_S=2

# Offsite copy is opt-in and remains disabled unless every setting passes validation.
# Mount a provider-specific credential file read-only with mode 0600. The initial
# Google Drive grant can read/delete its files; the application adapter itself exposes
# no delete/replace operation. See the owner-approved exception in the backup runbook.
HC_BACKUP_OFFSITE_ENABLED=false
HC_BACKUP_OFFSITE_PROVIDER=
HC_BACKUP_OFFSITE_DESTINATION=
HC_BACKUP_OFFSITE_CREDENTIAL_FILE=
# Google Drive adapter override: absolute host path to a mode-0600 rclone config.
HC_RCLONE_CONFIG_FILE_HOST=

# --- Owner ---
HC_OWNER_EMAIL=
HC_DEFAULT_TIMEZONE=UTC
HC_JOB_POLL_INTERVAL_S=2

# --- Abuse controls (hc-cbs.5) ---
# Compose supplies HC_REDIS_URL internally. Set this for a non-Docker production
# process; production startup fails if it is missing.
# HC_REDIS_URL=redis://localhost:6379/0
HC_LOGIN_RATE_LIMIT=5
HC_LOGIN_RATE_WINDOW_S=900
HC_MODEL_RATE_LIMIT=30
HC_MODEL_RATE_WINDOW_S=3600
HC_REPORT_RATE_LIMIT=6
HC_REPORT_RATE_WINDOW_S=3600

# --- Operational monitoring (docs/operations-runbook.md) ---
HC_MONITOR_INTERVAL_S=60
HC_MONITOR_REQUEST_ERROR_LIMIT=5
HC_MONITOR_AUTH_FAILURE_LIMIT=5
HC_MONITOR_MODEL_FAILURE_LIMIT=3
HC_MONITOR_QUEUE_AGE_LIMIT_S=300
HC_MONITOR_BACKUP_AGE_LIMIT_H=26
HC_MONITOR_DISK_FREE_PERCENT=10
# Enable only when Garmin imports are expected on a schedule; empty means disabled.
# HC_MONITOR_GARMIN_AGE_LIMIT_H=36

# Independent off-host availability probe (deploy/offhost-monitor.py). Run this on a
# different trusted host. The alert URL may contain a private topic and stays empty.
HC_TARGET_URL=
HC_ALERT_URL=
HC_STATE_FILE=./healthcurve-monitor.state

# --- Telegram (docs/telegram-setup.md) ---
# Polling is the default and needs no public endpoint: the worker calls Telegram
# outbound, so this works behind NAT or on a Tailscale-only machine (ADR-0008).
# Store class-C8 secrets in the encrypted credential table, not here. This path is
# non-secret and is mounted by deploy/credentials.compose.yml.
HC_CREDENTIAL_KEY_FILE_HOST=
# For a non-Compose process, set the in-process path directly instead of the host
# bind-mount source above.
# HC_CREDENTIAL_KEY_FILE=
# HC_TELEGRAM_ALLOWED_CHAT_ID=

# --- Garmin Connect (unofficial, opt-in; docs/garmin-connect.md) ---
# Use only with deploy/garmin.compose.yml. The token directory must be outside this
# repository, mode 0700, and backed up separately only if you accept its class-C8 risk.
HC_GARMIN_ENABLED=false
HC_GARMIN_EMAIL=
HC_GARMIN_PASSWORD=
HC_GARMIN_TOKEN_STORE_HOST=
# For a non-Compose worker, set its token-directory path directly instead.
# HC_GARMIN_TOKEN_STORE=
HC_GARMIN_SYNC_LOOKBACK_DAYS=7
# Host path is bind-mounted request-only into the worker. A trusted host bridge
# consumes it without mounting the repository or bd into the app container.
# HC_BEADS_OUTBOX_DIR=./var/beads-outbox
# HC_BEADS_BACKLOG_EPIC_ID=hc-inbox
#
# Development-only migration fallback. Production refuses to start if either
# plaintext secret is present in the environment.
# HC_TELEGRAM_BOT_TOKEN=
# Webhook mode is for a publicly hosted deployment only, and additionally needs:
# HC_TELEGRAM_MODE=webhook
# HC_TELEGRAM_WEBHOOK_SECRET=
# HC_PUBLIC_BASE_URL=https://health.example.com
